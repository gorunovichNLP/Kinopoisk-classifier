{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinopoisk-classifier.local/schemas/kafka/prediction-event-v1.schema.json",
  "title": "Kinopoisk sentiment prediction event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prediction_id",
    "source_event_id",
    "review_id",
    "sentiment",
    "label_id",
    "confidence",
    "probabilities",
    "model",
    "predicted_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prediction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^review:[0-9a-f]{24}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "movie_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "neg",
        "neu",
        "pos"
      ]
    },
    "label_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neg",
        "neu",
        "pos"
      ],
      "properties": {
        "neg": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neu": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predicted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
